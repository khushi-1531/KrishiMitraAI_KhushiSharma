# ===================================================================
# KrishiMitra AI - Backend Environment Configuration Template
# Copy this file to .env in the backend/ directory and set your values.
# Do NOT commit your actual .env file.
# ===================================================================

# [REQUIRED FOR STARTUP] Groq Cloud API Key
# Used for AI Chatbot responses, intent extraction, and Whisper STT.
# Note: The FastAPI server will fail to initialize if this variable is missing.
GROQ_API_KEY=your_groq_api_key_here

# [OPTIONAL] Groq Model (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# [OPTIONAL] Smallest.ai Waves API Key
# Used for backend text-to-speech audio synthesis.
SMALLEST_API_KEY=your_smallest_ai_api_key_here

# [OPTIONAL] OpenWeatherMap API Key
# Used by the backend chatbot when answering weather-related queries.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# [OPTIONAL] data.gov.in API Key
# Used to query live Agmarknet wholesale mandi prices.
MANDI_API_KEY=your_data_gov_in_api_key_here

# [OPTIONAL] Frontend URL (default: http://localhost:5173)
# Used to generate password reset links in emails.
FRONTEND_URL=http://localhost:5173

# [OPTIONAL] Google Cloud OAuth2 Credentials for Gmail Dispatch
# Required only for the Forgot Password email dispatch feature.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GMAIL_SENDER=your_email@gmail.com
