# ===================================================================
# KrishiMitra AI - Frontend Environment Configuration Template
# Copy this file to .env in the frontend project root and set your values.
# Do NOT commit your actual .env file.
# ===================================================================

# [REQUIRED FOR WEATHER PAGE] OpenWeatherMap Direct Browser Client
# Used by src/services/weatherService.js to fetch current and 5-day forecasts.
VITE_WEATHER_API_KEY=your_openweather_api_key_here
VITE_WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# [OPTIONAL] FastAPI Backend URL (default: http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

